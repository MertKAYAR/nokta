{
  "expo": {
    "name": "231118052-SpecGen",
    "slug": "231118052-spec-gen",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "specgen",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mert.specgen",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ses görselleştirme ve STT için mikrofon gereklidir.",
        "NSCameraUsageDescription": "Uzmanla görüntülü görüşme için kamera gereklidir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.mert.specgen",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-av",
      "expo-camera",
      [
        "expo-gl",
        {
          "enableExperimentalWorkletizedAnimations": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
